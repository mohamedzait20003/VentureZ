# identity-engine configuration (copy to .env for local dev)
GRPC_ADDR=:50053
DATABASE_URL=postgres://venturez:venturez@localhost:5432/venturez?sslmode=disable

# JWT signing (RS256). The private key stays in this service only.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_ISSUER=venturez-identity
ACCESS_TTL=15m
REFRESH_TTL=168h

# Email (SMTP). Leave SMTP_HOST empty to LOG emails instead of sending them.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com
#   SMTP_PASS=<app password>  (use an App Password, not your account password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VentureZ <no-reply@venturez.dev>

# Base URL used to build links in emails (your frontend).
APP_BASE_URL=http://localhost:3000
